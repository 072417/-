# Optional OpenAI-compatible vision service; leave empty for local analysis.
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
# App listens on loopback only. Data stays in this directory by default.
DESIGN_REVIEW_DATA=.data
# Public Linux deployment only:
# SITE_DOMAIN=review.example.com
# PUBLIC_MODE=true
# COOKIE_SECURE=true

# Container backend: exact production frontend origin, no wildcard.
ALLOWED_ORIGINS=
# Vercel build setting only: HTTPS origin of the running container backend.
BACKEND_ORIGIN=
